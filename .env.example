# Copia este archivo a .env para personalizar el entorno local.
# Valores solo para desarrollo; usa credenciales fuertes en producción.

# --- Base de datos (contenedor propio de este proyecto) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=encuestas
MYSQL_USER=encuestas
MYSQL_PASSWORD=encuestas
# Puerto expuesto en el host. 3307 por defecto para no chocar con otro
# MySQL local que ya ocupe el 3306.
MYSQL_PORT=3307

# --- Aplicación web ---
# Puerto del host para la app (8081 para no chocar con otros servicios locales).
WEB_PORT=8081
# development: muestra errores e inserta datos de demostración.
# production: errores genéricos, HSTS y cookies seguras.
APP_ENV=development
# Clave para firmar los tokens de confirmación de correo y restablecimiento de
# contraseña. Si se deja vacía en desarrollo se autogenera en var/app.key.
# En producción DEBE definirse (por ejemplo: openssl rand -hex 32).
APP_KEY=
# IPs o rangos CIDR (separados por comas) de los proxies inversos de confianza.
# Solo desde ellos se aceptan las cabeceras X-Forwarded-For / X-Forwarded-Proto.
# Ejemplo detrás de un balanceador: TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_PROXIES=
# true para redirigir todo el tráfico http a https en producción (requiere que
# la app termine TLS directamente o tras un proxy declarado en TRUSTED_PROXIES).
FORCE_HTTPS=false

# --- Conexión de la app a la BD (solo si ejecutas PHP fuera de Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=encuestas
DB_USERNAME=encuestas
DB_PASSWORD=encuestas
